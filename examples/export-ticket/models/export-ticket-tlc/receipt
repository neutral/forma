{"file":"ExportTicket.tla","sha256":"8d9558566338431abc81c88d9c0da8069554362a18bf3cf1cc4a3ce3852810ed","at":"2026-11-12T05:13:06.034Z","session":{"provider":"openai","model":"gpt-6-astra","session":"rehearsal-ticket3-w19"},"authors":[{"provider":"openai","model":"gpt-6-astra","session":"rehearsal-ticket3-w02"},{"provider":"openai","model":"gpt-6-astra","session":"rehearsal-ticket3-w09"},{"provider":"openai","model":"gpt-6-astra","session":"rehearsal-ticket3-w12"},{"provider":"openai","model":"gpt-6-astra","session":"rehearsal-ticket3-w19"}],"answers":["20261112T033610Z-rule-bbb6826c3c80","20261112T033611Z-rule-04b075eed2bf","20261112T050026Z-rule-ca2d7764e90e","20261112T050029Z-rule-f1595ccf7001"],"mechanisms":[{"decision":"20261112T033610Z-rule-bbb6826c3c80","mechanism":"Receipt creation checks that the ticket is still active in the same atomic store action that creates the receipt and marks the ticket claimed; a remembered passing check cannot authorize creation after expiry."},{"decision":"20261112T033611Z-rule-04b075eed2bf","mechanism":"Receipt creation checks that the ticket is still unclaimed in the same atomic store action that creates the receipt and marks the ticket claimed, so only one overlapping request key can create a receipt."},{"decision":"20261112T050026Z-rule-ca2d7764e90e","mechanism":"The original reply attempt can either follow the transport outcome or end with its reply lost, without delivery and without changing the stored receipt or claim; the journey explicitly selects the lost outcome and retains its original-receipt requirement."},{"decision":"20261112T050029Z-rule-f1595ccf7001","mechanism":"Retries reuse the durable receipt recorded for their request key; a key with no result may create its first receipt only while the ticket is active and unclaimed, checked atomically with recording that result, so expiry or another completed claim prevents new creation without blocking replay of an existing receipt."}],"before":"5b315995c436af439250c53fb