{
  "name": "@forma/explorer",
  "version": "0.1.0",
  "private": true,
  "description": "Reads a Forma project: the brief as written, with its examination beside each section.",
  "license": "CC0-1.0 OR 0BSD",
  "repository": "github:neutral/forma",
  "type": "module",
  "bin": {
    "forma-explorer": "./src/server/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "start": "node src/server/cli.ts serve",
    "export": "node src/server/cli.ts export",
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:browser": "vite build && playwright test"
  },
  "dependencies": {
    "@forma/cli": "workspace:*",
    "@xstate/react": "6.1.0",
    "@xyflow/react": "12.12.1",
    "elkjs": "0.12.1",
    "markdown-it": "14.3.3",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "xstate": "5.33.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
